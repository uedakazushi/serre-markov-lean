/-- The ordered outer coefficients force the next edge to be at most five. -/
theorem a_four_sorted_adjacent_le_five (z : Six) (hz : Chamber z) (ha : z.a=4)
    (hcd : z.d≤z.c) (hf : 4≤z.f) (ht : ShortTerminal z 3) : z.d≤5 := by
  by_contra hn
  have hd : 6≤z.d := by omega
  let B := z.b-3
  let C := z.c-z.d
  let D := z.d-6
  let E := z.e-3
  let F := z.f-4
  have heq : z=⟨4,B+3,C+D+6,D+6,E+3,F+4⟩ := by
    ext <;> dsimp [B,C,D,E,F] <;> simp [ha] <;> omega
  have hw : Chamber ⟨4,B+3,C+D+6,D+6,E+3,F+4⟩ := heq ▸ hz
  have htw : ShortTerminal ⟨4,B+3,C+D+6,D+6,E+3,F+4⟩ 3 := heq ▸ ht
  have hB : 0≤B := by dsimp [B]; linarith [hz.2.2.2.1]
  have hC : 0≤C := by dsimp [C]; omega
  have hD : 0≤D := by dsimp [D]; omega
  have hE : 0≤E := by dsimp [E]; linarith [hz.2.2.2.2.2.2.1]
  have hF : 0≤F := by dsimp [F]; omega
  have hq : q2 ⟨4,B+3,C+D+6,D+6,E+3,F+4⟩=4 ∨
      q2 ⟨4,B+3,C+D+6,D+6,E+3,F+4⟩= -4 := by
    have hh := hw.1.2
    have hprod : (q2 ⟨4,B+3,C+D+6,D+6,E+3,F+4⟩-4)*
        (q2 ⟨4,B+3,C+D+6,D+6,E+3,F+4⟩+4)=0 := by nlinarith only [hh]
    rcases mul_eq_zero.mp hprod with h | h <;> [left;right] <;> omega
  rcases hq with hq | hq
  · exact certificate_plus B C D E F hB hC hD hE hF hw htw hq
  · exact certificate_minus B C D E F hB hC hD hE hF hw htw hq

/-- This sorted first-edge-four slice has a unique one of the actual five classes. -/
theorem a_four_sorted_short_terminal_classification (z : Six) (hz : Chamber z)
    (ha : z.a=4) (hd : 4≤z.d) (hcd : z.d≤z.c) (hf : 4≤z.f)
    (ht : ShortTerminal z 3) : ∃! r : Fin 5, Reachable z (PositiveExamples.representative r) := by
  have hhi := a_four_sorted_adjacent_le_five z hz ha hcd hf ht
  have ht2 := shortTerminal_mono (by decide : 2≤3) ht
  have hcases : z.d=4 ∨ z.d=5 := by omega
  rcases hcases with hd4 | hd5
  · exact PositiveFourFour.a_four_d_four_short_terminal_classification z hz ha hd4 ht2
  · exact PositiveFourFive.a_four_d_five_short_terminal_classification z hz ha hd5 ht2

